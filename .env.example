# Nomadica environment settings.
# Copy this file to .env.local and fill in real values. Never commit .env.local.
#
# Without the Shopify values, `npm run dev` runs in sample mode: built-in sample
# products, sign-in, addresses and orders, for local development only.
# Production builds never use sample data.

# --- Shopify Storefront API (public catalog, cart, customer accounts) ---
# Store domain, e.g. your-store.myshopify.com
SHOPIFY_APP_URL=
# Storefront API access token (Shopify admin > Settings > Apps > Develop apps)
NEXT_PUBLIC_SHOPIFY_STOREFRONT_ACCESS_TOKEN=

# --- Shopify Admin API (server only: creates orders, order tracking) ---
# Admin API token from a custom app with: read_orders, write_draft_orders, read_draft_orders, read_products
SHOPIFY_ADMIN_ACCESS_TOKEN=
# Defaults to SHOPIFY_APP_URL when empty
SHOPIFY_ADMIN_SHOP=

# Shopify API version for all requests (default 2026-10). Shopify supports each
# version for about 12 months: https://shopify.dev/docs/api/usage/versioning
SHOPIFY_API_VERSION=2026-10

# --- Razorpay (card and UPI payments) ---
# Use rzp_test_ keys for testing
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Webhook secret you choose in Razorpay dashboard > Settings > Webhooks.
# Webhook URL: https://<your-domain>/api/webhooks/razorpay  Events: payment.captured, order.paid
RAZORPAY_WEBHOOK_SECRET=

# --- Shared rate limiting (optional, recommended in production) ---
# Upstash Redis REST credentials. Vercel KV's KV_REST_API_URL / KV_REST_API_TOKEN also work.
# Without these, rate limits apply per server instance only.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Site URLs, analytics and SEO (optional) ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
